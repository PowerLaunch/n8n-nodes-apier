{
  "name": "n8n-nodes-apier",
  "version": "0.1.0",
  "description": "n8n community node for Apier: Norwegian company signing authority, compliance summary and change monitoring from the official registers.",
  "keywords": [
    "n8n-community-node-package",
    "apier",
    "brreg",
    "norway",
    "signing-authority",
    "company-data"
  ],
  "license": "MIT",
  "homepage": "https://www.apier.no/use-cases/n8n",
  "author": {
    "name": "Apier",
    "url": "https://www.apier.no"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PowerLaunch/n8n-nodes-apier.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/ApierApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Apier/Apier.node.js",
      "dist/nodes/Apier/ApierTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "n8n-workflow": "2.16.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
